{
  "name": "weavestudio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "package:acquisition": "node scripts/package-release.mjs && python scripts/verify-acquisition-package.py release/weavestudio-acquisition-package release/weavestudio-acquisition-package.zip",
    "test:browser": "playwright test",
    "verify:buyer": "node scripts/validate-docs.mjs && node scripts/verify-buyer.mjs",
    "verify": "npm test && npm run lint && npm run typecheck && npm run build && npm run test:browser && npm run verify:buyer && npm run package:acquisition"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  }
}
